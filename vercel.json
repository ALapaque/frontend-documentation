{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/frontend-documentation/browser",
  "framework": null,
  "redirects": [
    { "source": "/css/next/css-2026", "destination": "/css/next/css-2027", "permanent": true },
    { "source": "/web/next/web-platform-2026", "destination": "/web/next/web-platform-2027", "permanent": true },
    { "source": "/tooling/next/tooling-2026", "destination": "/tooling/next/tooling-2027", "permanent": true }
  ],
  "headers": [
    {
      "source": "/og/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/(.*)\\.(js|css|woff2|svg)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
